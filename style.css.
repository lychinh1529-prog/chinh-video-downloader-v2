:root {
  --blue: #087bff;
  --blue-dark: #075de0;
  --blue-light: #eaf3ff;
  --bg: #f4f8ff;
  --white: #ffffff;
  --text: #122344;
  --muted: #7182a1;
  --border: #dce8fa;
  --shadow: 0 5px 22px rgba(37, 102, 190, .07);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  padding-bottom: calc(82px + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
  touch-action: manipulation;
}

button:focus-visible,
textarea:focus-visible,
input:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}

.app {
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  padding: 0 14px;
}

header {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 16px 0;
  margin-bottom: 15px;
}

.logo {
  width: 45px;
  height: 45px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(145deg, #3998ff, #0065ed);
  color: white;
  font-size: 23px;
  font-weight: 800;
  box-shadow: 0 5px 12px #087bff30;
}

header h1 {
  font-size: 19px;
  line-height: 1.25;
  letter-spacing: -.4px;
}

header h1 span {
  color: var(--blue);
}

header p {
  font-size: 12px;
  color: var(--muted);
}

.header-settings {
  margin-left: auto;
  width: 42px;
  height: 42px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--white);
  color: var(--text);
  font-size: 20px;
}

.section {
  display: none;
  animation: appear .2s ease-out;
}

.section.active {
  display: block;
}

@keyframes appear {
  from {
    opacity: .65;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero {
  padding: 17px 2px 21px;
}

.hero h2 {
  max-width: 420px;
  font-size: clamp(25px, 7vw, 34px);
  line-height: 1.23;
  letter-spacing: -.8px;
  font-weight: 800;
}

.hero h2 span {
  display: block;
  color: var(--blue);
}

.hero p {
  margin-top: 13px;
  color: #526582;
  font-size: 14px;
  line-height: 1.7;
}

.card {
  background: var(--white);
  border: 1px solid #e5edfa;
  border-radius: 18px;
  padding: 16px;
  margin-bottom: 14px;
  box-shadow: var(--shadow);
  min-width: 0;
}

.card h3 {
  font-size: 16px;
  line-height: 1.4;
  margin-bottom: 5px;
}

.muted,
.description {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.platform-heading {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 13px;
}

.section-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: var(--blue-light);
  color: var(--blue);
  font-size: 21px;
}

.platforms {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.platform {
  min-width: 0;
  min-height: 62px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 10px 7px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 13px;
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
  transition: background .15s, border-color .15s;
}

.platform.active {
  background: #edf5ff;
  border: 1.5px solid var(--blue);
  color: var(--blue);
}

.platform-icon {
  font-size: 21px;
}

.input-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.input-title h3 {
  margin-bottom: 3px;
}

textarea {
  display: block;
  width: 100%;
  min-height: 104px;
  max-height: 180px;
  resize: vertical;
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 13px;
  background: #fbfdff;
  color: var(--text);
  font-size: 14px;
  line-height: 1.55;
}

textarea::placeholder {
  color: #a4b1c7;
}

textarea.invalid {
  border-color: #e54858;
  background: #fffafa;
}

.input-info {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-top: 7px;
  color: var(--muted);
  font-size: 12px;
}

.warning {
  color: #e54858 !important;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  margin-top: 13px;
}

.btn {
  min-height: 45px;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 11px 12px;
  background: white;
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
}

.btn-light {
  background: #f5f8ff;
  color: var(--blue);
  border-color: #d6e7ff;
}

.btn-primary {
  background: linear-gradient(135deg, #1689ff, #075de0);
  color: white;
  border: none;
  box-shadow: 0 5px 13px #087bff30;
}

.btn-primary:active {
  transform: scale(.99);
}

.btn:disabled {
  opacity: .55;
  cursor: not-allowed;
  box-shadow: none;
}

.full-width {
  width: 100%;
}

.download-main {
  min-height: 50px;
  margin-top: 12px;
  font-size: 14px;
}

.status {
  display: none;
  margin-top: 12px;
  padding: 11px 12px;
  border-radius: 11px;
  background: var(--blue-light);
  color: #075de0;
  font-size: 13px;
  overflow-wrap: anywhere;
}

.status:not(:empty) {
  display: block;
}

.features {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px 10px;
  margin-top: 21px;
  padding-top: 17px;
  border-top: 1px solid #edf1f8;
}

.feature {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  min-width: 0;
}

.feature-icon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--blue-light);
  color: var(--blue);
  font-size: 17px;
}

.feature strong,
.feature span {
  display: block;
}

.feature strong {
  font-size: 12px;
  margin-bottom: 3px;
}

.feature span {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

.utilities {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 15px;
}

.utility {
  min-width: 0;
  padding: 14px 12px;
  background: white;
  border: 1px solid #e5edfa;
  border-radius: 16px;
  box-shadow: var(--shadow);
}

.utility-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  margin-bottom: 10px;
  border-radius: 12px;
  background: var(--blue-light);
  color: var(--blue);
  font-size: 21px;
}

.utility h3 {
  font-size: 14px;
  margin-bottom: 5px;
}

.utility p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.text-link {
  display: inline-block;
  margin-top: 10px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--blue);
  font-size: 12px;
  font-weight: 700;
  text-align: left;
}

.coming-soon {
  display: inline-block;
  margin-top: 10px;
  padding: 4px 8px;
  border-radius: 8px;
  background: #f0f4fa;
  color: #7182a1;
  font-size: 11px;
  font-weight: 700;
}

footer {
  padding: 24px 5px 12px;
  color: var(--muted);
  text-align: center;
  font-size: 11px;
  line-height: 1.8;
}

.page-heading {
  padding: 18px 2px 20px;
}

.page-heading h2 {
  font-size: 25px;
  line-height: 1.3;
  margin-bottom: 7px;
}

.page-heading p {
  color: var(--muted);
  font-size: 13px;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 0;
  border-top: 1px solid #edf1f8;
}

.setting-row p {
  font-size: 13px;
  font-weight: 700;
}

.setting-row small {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 12px;
  overflow-wrap: anywhere;
}

.bottom-nav {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5px;
  padding: 9px 12px calc(9px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .97);
  border-top: 1px solid var(--border);
  box-shadow: 0 -5px 20px rgba(37, 102, 190, .06);
  backdrop-filter: blur(12px);
}

.nav-btn {
  min-width: 0;
  min-height: 49px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: #7b8ba5;
  font-size: 11px;
  font-weight: 700;
}

.nav-btn span {
  font-size: 20px;
  line-height: 1.2;
}

.nav-btn.active {
  background: var(--blue-light);
  color: var(--blue);
}

@media (min-width: 600px) {
  .app {
    padding: 0 20px;
  }

  header {
    padding-top: 22px;
  }

  .hero {
    padding-top: 22px;
  }

  .card {
    padding: 20px;
  }

  .utilities {
    gap: 14px;
  }
}

@media (max-width: 350px) {
  .app {
    padding: 0 10px;
  }

  .card {
    padding: 13px;
  }

  .platform {
    gap: 5px;
    font-size: 12px;
  }

  .platform-icon {
    font-size: 18px;
  }

  .features {
    gap: 13px 7px;
  }

  .feature {
    gap: 6px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
