:root {
  --blue: #087bff;
  --blue-dark: #075de0;
  --blue-light: #eaf3ff;
  --bg: #f4f8ff;
  --white: #ffffff;
  --text: #122344;
  --muted: #7182a1;
  --border: #dce8fa;
  --shadow: 0 5px 22px rgba(37, 102, 190, .07);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  padding-bottom: calc(82px + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
  touch-action: manipulation;
}

button:focus-visible,
textarea:focus-visible,
input:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}

.app {
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  padding: 0 14px;
}

header {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 16px 0;
  margin-bottom: 15px;
}

.logo {
  width: 45px;
  height: 45px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(145deg, #3998ff, #0065ed);
  color: white;
  font-size: 23px;
  font-weight: 800;
  box-shadow: 0 5px 12px #087bff30;
}

header h1 {
  font-size: 19px;
  line-height: 1.25;
  letter-spacing: -.4px;
}

header h1 span {
  color: var(--blue);
}

header p {
  font-size: 12px;
  color: var(--muted);
}

.header-settings {
  margin-left: auto;
  width: 42px;
  height: 42px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--white);
  color: var(--text);
  font-size: 20px;
}

.section {
  display: none;
  animation: appear .2s ease-out;
}

.section.active {
  display: block;
}

@keyframes appear {
  from {
    opacity: .65;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero {
  padding: 17px 2px 21px;
}

.hero h2 {
  max-width: 420px;
  font-size: clamp(25px, 7vw, 34px);
  line-height: 1.23;
  letter-spacing: -.8px;
  font-weight: 800;
}

.hero h2 span {
  display: block;
  color: var(--blue);
}

.hero p {
  margin-top: 13px;
  color: #526582;
  font-size: 14px;
  line-height: 1.7;
}

.card {
  background: var(--white);
  border: 1px solid #e5edfa;
  border-radius: 18px;
  padding: 16px;
  margin-bottom: 14px;
  box-shadow: var(--shadow);
  min-width: 0;
}

.card h3 {
  font-size: 16px;
  line-height: 1.4;
  margin-bottom: 5px;
}

.muted,
.description {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.platform-heading {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 13px;
}

.section-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: var(--blue-light);
  color: var(--blue);
  font-size: 21px;
}

.platforms {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.platform {
  min-width: 0;
  min-height: 62px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 10px 7px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 13px;
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
  transition: background .15s, border-color .15s;
}

.platform.active {
  background: #edf5ff;
  border: 1.5px solid var(--blue);
  color: var(--blue);
}

.platform-icon {
  font-size: 21px;
}

.input-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.input-title h3 {
  margin-bottom: 3px;
}

textarea {
  display: block;
  width: 100%;
  min-height: 104px;
  max-height: 180px;
  resize: vertical;
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 13px;
  background: #fbfdff;
  color: var(--text);
  font-size: 14px;
  line-height: 1.55;
}

textarea::placeholder {
  color: #a4b1c7;
}

textarea.invalid {
  border-color: #e54858;
  background: #fffafa;
}

.input-info {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-top: 7px;
  color: var(--muted);
  font-size: 12px;
}

.warning {
  color: #e54858 !important;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  margin-top: 13px;
}

.btn {
  min-height: 45px;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 11px 12px;
  background: white;
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
}

