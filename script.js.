"use strict";

const $ = (selector) => document.querySelector(selector);
const $$ = (selector) => document.querySelectorAll(selector);

const urlInput = $("#videoUrl");
const charCount = $("#charCount");
const clearBtn = $("#clearBtn");
const pasteBtn = $("#pasteBtn");
const downloadBtn = $("#downloadBtn");
const statusBox = $("#statusBox");
const platformName = $("#platformName");

const MAX_LENGTH = 500;

function showStatus(message) {
  if (!statusBox) return;

  statusBox.textContent = message;
  statusBox.classList.add("show");
}

function hideStatus() {
  if (!statusBox) return;
  statusBox.textContent = "";
  statusBox.classList.remove("show");
}

function detectPlatform(value) {
  const text = value.trim();

  if (!text) return "";

  try {
    const url = new URL(text);
    const host = url.hostname.toLowerCase().replace(/^www\./, "");

    if (
      host === "youtube.com" ||
      host.endsWith(".youtube.com") ||
      host === "youtu.be"
    ) {
      return "YouTube";
    }

    if (
      host === "douyin.com" ||
      host.endsWith(".douyin.com") ||
      host === "iesdouyin.com" ||
      host.endsWith(".iesdouyin.com")
    ) {
      return "Douyin";
    }

    if (
      host === "bilibili.com" ||
      host.endsWith(".bilibili.com") ||
      host === "b23.tv"
    ) {
      return "Bilibili";
    }

    if (
      host === "tiktok.com" ||
      host.endsWith(".tiktok.com")
    ) {
      return "TikTok";
    }

    return "Không xác định";
  } catch {
    return "Liên kết chưa hợp lệ";
  }
}

function updateInput() {
  if (!urlInput) return;

  const value = urlInput.value;
  const length = value.length;
  const platform = detectPlatform(value);

  if (charCount) {
    charCount.textContent = `${length}/${MAX_LENGTH}`;
    charCount.classList.toggle(
      "warning",
      length >= MAX_LENGTH
    );
  }

  if (platformName) {
    platformName.textContent = platform
      ? `Nền tảng: ${platform}`
      : "Nền tảng: Chưa xác định";
  }

  $$(".platform").forEach((item) => {
    item.classList.toggle(
      "active",
      Boolean(platform) &&
      platform !== "Không xác định" &&
      platform !== "Liên kết chưa hợp lệ" &&
      item.dataset.platform === platform
    );
  });

  if (downloadBtn) {
    downloadBtn.disabled =
      !value.trim() || length > MAX_LENGTH;
  }
}

function navigateTo(target) {
  const section = document.getElementById(target);

  if (!section) return;

  $$(".section").forEach((item) => {
    item.classList.toggle("active", item === section);
  });

  $$(".nav-btn").forEach((button) => {
    button.classList.toggle(
      "active",
      button.dataset.target === target
    );
  });

  window.scrollTo({
    top: 0,
    behavior: "auto"
  });
}

// Nhập liên kết và nhận diện nền tảng.
if (urlInput) {
  urlInput.addEventListener("input", () => {
    updateInput();
    hideStatus();
  });

  // Chặn nội dung dán vượt quá 500 ký tự.
  urlInput.addEventListener("paste", (event) => {
    const pasted =
      event.clipboardData?.getData("text") || "";

    const start = urlInput.selectionStart;
    const end = urlInput.selectionEnd;

    const available =
      MAX_LENGTH -
      (urlInput.value.length - (end - start));

    if (pasted.length > available) {
      event.preventDefault();

      const insertText = pasted.slice(
        0,
        Math.max(0, available)
      );

      urlInput.setRangeText(
        insertText,
        start,
        end,
        "end"
      );

      updateInput();
      showStatus("Liên kết đã được giới hạn ở 500 ký tự.");
    }
  });
}

// Xóa liên kết.
if (clearBtn && urlInput) {
  clearBtn.addEventListener("click", () => {
    urlInput.value = "";
    updateInput();
    hideStatus();
    urlInput.focus();
  });
}

// Dán từ clipboard.
if (pasteBtn && urlInput) {
  pasteBtn.addEventListener("click", async () => {
    try {
      if (!navigator.clipboard?.readText) {
        throw new Error("Clipboard unavailable");
      }

      const text = await navigator.clipboard.readText();

      urlInput.value = text.slice(0, MAX_LENGTH);
      updateInput();

      if (text.length > MAX_LENGTH) {
        showStatus(
          "Nội dung vượt quá 500 ký tự. Đã lấy 500 ký tự đầu."
        );
      } else if (!text.trim()) {
        showStatus("Bộ nhớ tạm đang trống.");
      } else {
        showStatus("Đã dán liên kết. Hãy kiểm tra trước khi tiếp tục.");
      }
    } catch {
      showStatus(
        "Không thể truy cập bộ nhớ tạm. Hãy chạm giữ ô nhập rồi chọn Dán."
      );
    }
  });
}

// Chọn nền tảng bằng cách chạm vào thẻ.
$$(".platform").forEach((item) => {
  item.addEventListener("click", () => {
    const platform = item.dataset.platform;

    if (!platformName) return;

    platformName.textContent =
      `Nền tảng đã chọn: ${platform}. Dán liên kết để xác nhận.`;
  });
});

// Nút tải: hiện tại chỉ kiểm tra liên kết, chưa gọi API.
if (downloadBtn && urlInput) {
  downloadBtn.addEventListener("click", () => {
    const value = urlInput.value.trim();

    if (!value) {
      showStatus("Hãy dán liên kết video trước.");
      return;
    }

    if (value.length > MAX_LENGTH) {
      showStatus("Liên kết không được vượt quá 500 ký tự.");
      return;
    }

    const platform = detectPlatform(value);

    if (
      !platform ||
      platform === "Không xác định" ||
      platform === "Liên kết chưa hợp lệ"
    ) {
      showStatus(
        "Liên kết chưa hợp lệ hoặc chưa thuộc 4 nền tảng được hỗ trợ."
      );
      return;
    }

    showStatus(
      `Đã nhận diện ${platform}. Chức năng tải video thật sẽ hoạt động sau khi tích hợp API.`
    );
  });
}

// Chuyển các trang ở thanh điều hướng.
$$(".nav-btn").forEach((button) => {
  button.addEventListener("click", () => {
    navigateTo(button.dataset.target);
  });
});

// Các nút điều hướng nằm trong thẻ nội dung.
$$("[data-go]").forEach((button) => {
  button.addEventListener("click", () => {
    navigateTo(button.dataset.go);
  });
});

// Nút cài đặt trên đầu trang.
const headerSettings = $("#headerSettings");

if (headerSettings) {
  headerSettings.addEventListener("click", () => {
    navigateTo("settings");
  });
}

// Khởi tạo giao diện.
updateInput();
