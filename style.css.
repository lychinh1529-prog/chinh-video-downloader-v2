* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  color-scheme: dark;
  --bg: #0b0d12;
  --card: #151923;
  --card-light: #1d2330;
  --text: #f4f6fb;
  --muted: #929bad;
  --primary: #7c5cff;
  --border: #2a3040;
  --danger: #ff5263;
}

body {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, sans-serif;
  padding-bottom: 90px;
}

button,
textarea,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
textarea:focus-visible,
input:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 3px;
}

.app {
  width: 100%;
  max-width: 620px;
  margin: 0 auto;
  padding: 22px 16px;
}

header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
}

.logo {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  background: linear-gradient(135deg, #9d7aff, #6244f5);
  font-size: 23px;
  font-weight: bold;
}

header h1 {
  font-size: 21px;
  margin-bottom: 5px;
}

header p,
.muted {
  color: var(--muted);
  font-size: 13px;
}

.section {
  display: none;
}

.section.active {
  display: block;
}

.section-title {
  font-size: 25px;
  margin-bottom: 9px;
}

.description {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 22px;
}

.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
  margin-bottom: 16px;
}

.card h3 {
  font-size: 16px;
  margin-bottom: 13px;
}

.platforms {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 18px;
}

.platform {
  background: var(--card-light);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 3px;
  text-align: center;
  font-size: 12px;
  color: var(--muted);
}

.platform.active {
  border-color: var(--primary);
  color: #c8bcff;
  background: #211b3a;
}

textarea {
  width: 100%;
  min-height: 115px;
  resize: vertical;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #0e1119;
  color: var(--text);
  padding: 14px;
  font-size: 14px;
  line-height: 1.5;
}

textarea::placeholder,
input::placeholder {
  color: #737d91;
}

textarea.invalid {
  border-color: var(--danger);
}

